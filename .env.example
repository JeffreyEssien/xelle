# ─── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for admin auth + all privileged writes. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Admin auth (Phase 1.1: DB accounts) ──────────────────────────
# Seed the first super_admin with `npm run seed:admin` after running
# migration 002_admin_auth.sql.
INITIAL_ADMIN_EMAIL=owner@xelle.com
INITIAL_ADMIN_PASSWORD=change-me-min-8-chars
INITIAL_ADMIN_NAME=Owner

# Legacy cutover ONLY. When "true", the old shared-password login + static
# session cookie still work so a deploy isn't locked out before seeding.
# Leave unset/false in normal operation; removed after Phase 1.2 cutover.
ADMIN_LEGACY_PASSWORD_FALLBACK=false
ADMIN_PASSWORD=legacy-shared-password
ADMIN_SESSION_SECRET=legacy-random-session-secret

# ─── Cloudinary (media gallery) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# ─── Email (Nodemailer / Gmail SMTP) ──────────────────────────────
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=your-app-password

# ─── Misc ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
